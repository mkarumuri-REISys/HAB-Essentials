<?xml version="1.0"?>
<log4net debug="true">
	<!-- Setup the root category, add the appenders and set the default priority -->
	<!-- levels: DEBUG, INFO, WARN, ERROR, FATAL -->
	<root>
		<level value="DEBUG"/>

		<!--<appender-ref ref="UdpAppender"/>-->
		<!--   <appender-ref ref="FileAppender"/> -->
		<appender-ref ref="FileAppender"/>
		<!--<appender-ref ref="ColoredConsoleAppender"/>-->
	</root>

	<logger name="AuditLogger">
		<level value="DEBUG"/>
		<appender-ref ref="FileAppender_audit"/>
	</logger>


	<logger name="NHibernate" additivity="false">
		<level value="WARN" />
	</logger>

	<logger name="NHibernate.Cache.CacheFactory" additivity="false">
		<level value="ALL" />
		<appender-ref ref="CacheAppender"/>
	</logger>


	<!--  additivity="false" added to indicate that all NH SQLs are logged to its own logger -->
	<logger name="NHibernate.SQL" additivity="false">
		<level value="ALL" />
		<appender-ref ref="SQLAppender"/>
	</logger>


	<!-- NH SQL Logger -->
	<appender name="CacheAppender" type="log4net.Appender.RollingFileAppender">
		<lockingModel type="log4net.Appender.FileAppender+MinimalLock" />
		<file value="Y:\logs\Ptr\Ptr-cache.log"/>
		<param name="AppendToFile" value="true"/>
		<param name="rollingStyle" value="Date"/>
		<param name="datePattern" value="yyyy-MM-dd"/>
		<encoding value="utf-8"/>
		<filter type="log4net.Filter.LoggerMatchFilter">
			<loggerToMatch value="NHibernate.Cache.CacheFactory" />
			<acceptOnMatch value="true" />
		</filter>
		<filter type="log4net.Filter.DenyAllFilter" />
		<layout type="log4net.Layout.PatternLayout">
			<conversionPattern value="%date [%thread] %-5level %logger [%property{NDC}] - %message%newline"/>
		</layout>

	</appender>

	<!-- NH SQL Logger -->
	<appender name="SQLAppender" type="log4net.Appender.RollingFileAppender">
		<lockingModel type="log4net.Appender.FileAppender+MinimalLock" />
		<file value="Y:\logs\Ptr\Ptr-sql.log"/>
		<param name="AppendToFile" value="true"/>
		<param name="rollingStyle" value="Date"/>
		<param name="datePattern" value="yyyy-MM-dd"/>
		<encoding value="utf-8"/>
		<filter type="log4net.Filter.LoggerMatchFilter">
			<loggerToMatch value="NHibernate.SQL" />
			<acceptOnMatch value="true" />
		</filter>
		<filter type="log4net.Filter.DenyAllFilter" />
		<layout type="log4net.Layout.PatternLayout">
			<conversionPattern value="%date [%thread] %-5level %logger [%property{NDC}] - %message%newline"/>
		</layout>

	</appender>

	<!-- NH SQL Logger -->
	<appender name="NHibernate" type="log4net.Appender.RollingFileAppender">
		<lockingModel type="log4net.Appender.FileAppender+MinimalLock" />
		<file value="Y:\logs\Ptr\Ptr-nh.log"/>
		<param name="AppendToFile" value="true"/>
		<param name="rollingStyle" value="Date"/>
		<param name="datePattern" value="yyyy-MM-dd"/>
		<encoding value="utf-8"/>
		<filter type="log4net.Filter.LoggerMatchFilter">
			<loggerToMatch value="NHibernate" />
			<acceptOnMatch value="true" />
		</filter>
		<filter type="log4net.Filter.DenyAllFilter" />
		<layout type="log4net.Layout.PatternLayout">
			<conversionPattern value="%date [%thread] %-5level %logger [%property{NDC}] - %message%newline"/>
		</layout>
	</appender>

	<appender name="FileAppender" type="log4net.Appender.RollingFileAppender">
		<lockingModel type="log4net.Appender.FileAppender+MinimalLock" />
		<file value="Y:\logs\Ptr\Ptr.log"/>
		<param name="AppendToFile" value="true"/>
		<param name="rollingStyle" value="Date"/>
		<param name="datePattern" value="yyyy-MM-dd"/>
		<encoding value="utf-8"/>
		<layout type="log4net.Layout.PatternLayout">
			<conversionPattern value="%date [%thread] %-5level %logger [%property{NDC}] - %message%newline"/>
		</layout>
	</appender>

	<appender name="FileAppender_audit" type="log4net.Appender.RollingFileAppender">
		<lockingModel type="log4net.Appender.FileAppender+MinimalLock" />
		<file value="Y:\logs\Ptr\Ptr-audit.log"/>
		<param name="AppendToFile" value="true"/>
		<param name="rollingStyle" value="Date"/>
		<param name="datePattern" value="yyyy-MM-dd"/>
		<encoding value="utf-8"/>
		<layout type="log4net.Layout.PatternLayout">
			<conversionPattern value="%date [%thread] %-5level %logger [%property{NDC}] - %message%newline"/>
		</layout>
	</appender>

</log4net>
