<statements xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="file://Y:/workspace/tools/REISchemas/REIData.xsd">


  <statement name="GetGridLayouts" connection = "Common">
    <param id="CreatorId" type="Guid"  />
    <param id="GroupName" type="string" />
    <param id="RunTimePageId" type="string" />
    <param id ="IncludeRunTimePage" type ="Int16"/>
    <sql>
      SELECT
      GridLayoutId  as 'Id'
      ,Name  as 'Name'
      ,GroupName as 'GroupName'
      ,IsDefault as 'IsDefault'
      ,RunTimePageId as 'RunTimePageId'
      ,ColumnDetails  as 'ColumnDetails'
      ,[CreatorId]   as 'CreatorId'
      ,[CreatedDate]  as 'CreatedDate'
      ,[LastUpdateId]  as 'LastUpdateId'
      ,[LastUpdateDate]  as 'LastUpdateDate'
      FROM PFM_COMP_GridLayout
      <where>
        <exp op="and">
          <exp op="=" dbField="CreatorId" paramId="CreatorId" />
          <exp op="=" dbField="GroupName" paramId="GroupName" />
        </exp>
      </where>
      <optional depends="IncludeRunTimePage == 1">
        AND RunTimePageId = <exp paramId="RunTimePageId" />
      </optional>
      <optional depends="IncludeRunTimePage == 0">
        AND RuntimePageId is null
      </optional>
      order by LastUpdateDate



    </sql>
  </statement>

  <statement name="GetGridLayout" connection = "Common">
