<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="file://Y:/PlatformTestHarness/Config/Platform/Common/XSD/Solution.xsd">
    <default>
        <layout visible="true" windowTitleSuffix="HRSA EHBs" windowIconPath="~/Platform/Include/Skins/{0}/Images/favicon.ico">
          <sessionOffset visible="false"/>
            <header visible="true" mode="Expand">
                <banner visible="true" popupHeading="HRSA Electronic Handbooks" homePagePath="http://www.hrsa.gov/" imagePath="~/Platform/Include/Skins/{0}/Images/hrsa_t_logo.png">
                    <value>
                        <![CDATA[<div id="logowrapper">
                                                        <div class="logo">
                                                            <a href="{0}"target="_blank">
                                                                <img id="Img1" src="{1}"  alt="HRSA"  /></a>
                                                        </div>
                                                        <h1 class="title">
                                                            <a href="{0}" id="site-name">HRSA</a> Electronic Handbooks 
                                                        </h1>
                                                        <div class="classicView hideItem">(<a href="{2}">Switch to Classic</a>)</div>
                                                    </div>]]>
                    </value>
                </banner>
                <topMenu visible="true">
                    <changePassword popUp="true" />
                </topMenu>
                <globalSearch visible="true" />
                <contentTab visible="true" currentMarkupId="homeTab"  />
            </header>

            <!--Default Settings-->
            <leftMenu visible="true" hierarchy="Role,Process" loadingMode="Client">
                <filter visible="true">
                    <criteria name="Tabs"/>
                    <criteria name="Role"/>
                </filter>
            </leftMenu>

            <footer visible= "true" solutionName="" platformVersion = "" solutionVersion = "" environment="#{EHB_Environment}">
                <navigations />
                <footerLogo >
                    <footerLogo>
                        <![CDATA[
                   <div class="govlogos">
			                 <a href="http://www.hhs.gov" target="_blank">
                          <img id="Img1" runat="server" src="{0}" alt="HHS.gov Logo" class="hhs" /></a> <a href="http://www.hrsa.gov" target="_blank">
                                  <img id="Img2" runat="server" src="{1}" alt="HRSA.gov Logo" width="71" height="19" />
                       </a>
            </div>
                ]]>
                    </footerLogo>
                </footerLogo>
                <!--<footerLogo img1="~/Platform/Include/Skins/{0}/Images/hhs_small_logo.gif" img2="~/Platform/Include/Skins{0}/Images/hrsa_small_logo.gif"/>-->
            </footer>
            <toolBar visible="true" helpUrl="https://help.hrsa.gov/display/EHBSHELP/Toolbar" type="Page">
                <pageContextMessage visible="true"  />
                <globalMessage visible="true" />
                <portfolio visible="false"/>
            </toolBar>
            <systemMessage visible="false" useGlobal="false" />
            <systemAnnouncement visible="false" useGlobal="false" />

            <generalInformation visible="true">
                <value>
                    <![CDATA[
                    <div class="sectionintro">
                    <h2>
                        <strong></strong>Getting Started with the Handbooks</h2>
                </div>
                <ul class="sectionwelcome">
                    <li><a href="{0}/Interface/Common/BrowserSettings.aspx">Recommended Settings</a></li>
                    <li>
                        <a class="externalIcon" href="javascript:OpenPopup('{0}/Interface/Common/UserInterfaceCrosswalk.pdf', screen.availHeight, screen.availWidth, 'UIC');">
                          User Interface Crosswalk
                          <span class="hidden-offscreen">- Opens in a new window</span>
                        </a>
                    </li>
                    <li>
                        <a class="externalIcon" href="javascript:var thWindow = window.open('{0}/Interface/Common/TourHandbook.aspx', 'UIC', 'height=600,width=980');thWindow.focus();">
                          Tour the Handbooks!
                          <span class="hidden-offscreen">- Opens in a new window</span>
                        </a>   
                    </li>
                </ul>
                ]]>
                </value>
            </generalInformation>
            <breadCrumb visible="false" externalSystemDimensionCode="" externalSystemCode=""></breadCrumb>
            <pageTitle visible="false" />
            <cssOptions crunch="false" combine="false"/>
            <scriptOptions crunch="false" combine="false"/>
            <sanitizeQueryString>
              <parameter name="controlName"/>
              <parameter name="CurrentTab"/>
            </sanitizeQueryString>
        </layout>
        <authorization>
            <location></location>
        </authorization>
        <statePersistence>
            <viewstate compression="None" viewStateStore="ClientBrowser"/>
        </statePersistence>
    </default>
</config>