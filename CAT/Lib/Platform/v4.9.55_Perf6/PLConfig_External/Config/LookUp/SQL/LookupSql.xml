	<statement name="GetTaskTypeLookup">
		<sql>
			<param id="TaskPhaseCode" type="Int32" />
			<param id="RoleId" type="Int32" />
			SELECT * FROM Gems.dbo.LookupTaskType (NOLOCK)
			<where>
				<exp op="and">
					<exp op="=" dbField="TaskPhaseCode" paramId="TaskPhaseCode" />
					<exp op="=" dbField="RoleId" paramId="RoleId" />
				</exp>
			</where>
		</sql>
	</statement>
