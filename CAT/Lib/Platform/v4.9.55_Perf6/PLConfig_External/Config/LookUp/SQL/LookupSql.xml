  <statement name="GetPageUrls" connection="GEMS">
    Select p.Id as LookupCode, (cast(DimensionValue as varchar) + RelativeUrl) as DisplayValue from PFM_CORE_PreDefinedPage p
    join ExternalSystemDimensionValue v on
      p.ExternalSystemCode = v.ExternalSystemCode and
      p.ExternalSystemDimensionCode = v.ExternalSystemDimensionCode
  </statement>
