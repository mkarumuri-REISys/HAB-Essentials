	<statement name="GetNewBureauIdsLookup">
		<sql>
			SELECT InternalOrgId as LookUpCode,Null as InactiveDate,OrgCode as DisplayValue, *
			from Gems.dbo.INTERNALORGANIZATIONS IORG
			JOIN Gems.dbo.InternalOrganizationRelationships IR ON IORG.InternalOrgId = IR.InternalOrg1Id AND IORG.InternalOrgInstance = IR.InternalOrg1Instance
			WHERE InternalOrgTypeCode=6 AND IR.InternalOrgRelationshipTypeCode = 6
			order by OrgCode
		</sql>
	</statement>
