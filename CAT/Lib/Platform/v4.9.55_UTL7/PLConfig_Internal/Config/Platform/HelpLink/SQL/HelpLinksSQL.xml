        <column dbField ="LinkTypeCode" paramId ="HelpLinkTypeCode" />
        <column dbField ="FriendlyName" paramId ="FriendlyName" />
      </columns>
    </sql>
  </statement>


  <statement name ="UpdateHelpLinkAssociationWithFriendlyName" connection ="Common">
    <param id ="viewId" type ="String"/>
    <param id ="externSystemCode" type ="Int32" required ="true"/>
