<webConfig>
  <errorLog>Y:\logs\EPS\ProgramSystemAdmin</errorLog>
  <sendConformationEmail>YES</sendConformationEmail>
  <debugMode>false</debugMode>
    <authType>
    <authDomain>#{ProdEnv.EHBEPS.authDomain}</authDomain>
    <authSource>#{ProdEnv.EHBEPS.InternalAuthSource}</authSource>
    <domainIPRange>#{ProdEnv.EHBEPS.domainIPRange}</domainIPRange>
    <ADauthUrl>#{ProdEnv.EHBEPS.ADauthUrl}</ADauthUrl>
    <PIVauthUrl>#{ProdEnv.EHBEPS.PIVauthUrl}</PIVauthUrl>
    <ClientIPIdentifier>#{ProdEnv.EHBEPS.ClientIPIdentifier}</ClientIPIdentifier>
  </authType>
  <IPBasedAuthentication>true</IPBasedAuthentication>
  <!--<errorLookUpFile>Y:\Config\Interface\ErrorDefinitions.xml</errorLookUpFile>-->
  <sessionTimeOut>30</sessionTimeOut>
  <AccountLockOutEffectiveMinutes>30</AccountLockOutEffectiveMinutes>
  <sessionTimeOutWarning>5</sessionTimeOutWarning>
  <userType>8</userType>
  <loginRedirectURL>Interface/Common/AccessControl/login.aspx</loginRedirectURL>
  <!--<defaultSideMenuFile></defaultSideMenuFile>-->
  <feedbackLink>#{EHB_ExternalfeedbackLink}</feedbackLink>
  <trackerUrl>https://hrsa.reisys.com/webtracker/tracker.asp</trackerUrl>
  <HRSAContactLink>http://itservicedesk.nih.gov/Support/</HRSAContactLink>
  <fileServerPath>#{Env.FileServer}</fileServerPath>
  <virusScanFlag>false</virusScanFlag>
  <scanServiceLocation>Server:192.168.3.33:7777</scanServiceLocation>
  <scanFolderLocation>Y:\Temp</scanFolderLocation>
  <allowableFileTypes>doc,rtf,txt,wpd,pdf,xls,xlsx,ppt,msg,msgx,jpg,jpeg,tif,docx,xfd,pptx</allowableFileTypes>
  <allowableFileSize>104857600</allowableFileSize>
  <fileTransferTimeOut>1800</fileTransferTimeOut>
  <layoutCaching>true</layoutCaching>
  <buildNumber>1.0.0.3</buildNumber>
  <environment>#{Env.EnvironmentName}</environment>
  <disableAddressStandardization>#{Env.DisableAddressStandardization_Pfm4_9_X}</disableAddressStandardization>
  <passwordExpirationDays>120</passwordExpirationDays>
  <allowedPasswordHistoryCount>6</allowedPasswordHistoryCount>
  <tempFolder>Y:\Temp\</tempFolder>
