        <navigation destination="~/This is a try" navigationItemId="firstLinkId" description="this is a try" displayValue="First Link" markupID="firstLink">
          <navigation destination="~/This is a try" navigationItemId="secondLinkId" description="this is a try" displayValue="Second Link" markupID="secondLink" parentID="firstLinkId" >
            <navigation destination="~/This is a try" navigationItemId="thirdLinkId" description="this is a try" displayValue="Third Link" markupID="ThirdLink" parentID="secondLinkId" >

            </navigation>
          </navigation>
        </navigation>
      </leftMenu>
      <footer visible= "true" solutionName="BRS" platformVersion = "4.9.55.0" solutionVersion = "" environment= "Development">
        <navigations>
           <navigation destination="{0}/Interface/Common/Policy.aspx" navigationItemId="PolicyLink" description="Acceptable Use Policy"  displayValue="Acceptable Use Policy" markupID="firstLink" parentID=""  />
          <navigation destination="{0}/Interface/Common/Accessibility.aspx" navigationItemId="AccessibilityLink" description="Accessibility" displayValue="Accessibility" markupID="secondLink" parentID=""  />
          <navigation destination="{0}/Interface/Common/Viewers.aspx" navigationItemId="ViewersAndPlayersLink" description="Viewers And Players" displayValue="Viewers And Players" markupID="fourthLink"  parentID=""/>
          <navigation destination="{0}/Interface/Common/ContactUs.aspx" navigationItemId="ContactUs" description="Contact Us" displayValue="Contact Us" markupID="fifthLink" parentID=""/>
        </navigations>
        <footerLogo  visible ="false" img1="~/Platform/Include/Skins/{0}/Images/hhs_small_logo.gif" img2="~/Platform/Include/Skins/{0}/Images/hrsa_small_logo.gif">
          <footerLogo>
            <![CDATA[
                   <div class="govlogos">
			                 <a href="http://www.hhs.gov" target="_blank">
                          <img id="Img1" runat="server" src="{0}" alt="HHS.gov" class="hhs" /></a> <a href="http://www.hrsa.gov" target="_blank">
                                  <img id="Img2" runat="server" src="{1}" alt="HRSA.gov" width="71" height="19" />
                       </a>
            </div>
                ]]>
          </footerLogo>
        </footerLogo>
