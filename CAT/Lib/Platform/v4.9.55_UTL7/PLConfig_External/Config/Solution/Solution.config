      </systemMessage>
      <systemAnnouncement visible="false" useGlobal="false">
        <value>System Announcement</value>
      </systemAnnouncement>
      <generalInformation visible="true">
        <value>
          <![CDATA[
                    <div class="sectionintro">
                    <h2>
                        <strong></strong>Getting Started with the Handbooks</h2>
                </div>
                <ul class="sectionwelcome">
                    <li><a href="#">Recommended Browser Settings</a></li>
                    <li><a href="#">User Interface Crosswalk</a></li>
                    <li><a href="#">Tour the Handbooks!</a></li>
                </ul>
                ]]>
        </value>
      </generalInformation>
      <breadCrumb visible="false" externalSystemDimensionCode="" externalSystemCode=""></breadCrumb>
      <pageTitle visible="false" />
      <cssOptions crunch="true" combine="true"/>
      <scriptOptions crunch="true" combine="true"/>
    </layout>
  </default>
  <pageGroup id="Module1">
    <layout visible="true" windowTitle="Welcome | Electronic Handbooks for Grantors">
      <header visible="true" mode="Expand">
        <banner visible="true" />
        <topMenu visible="true" />
        <globalSearch visible="true" />
        <contentTab visible="true" currentMarkupId="" />
      </header>
      <leftMenu visible="true" mode="Expand" currentMarkupId="" title="All Tasks">
        <filter visible="true" />
      </leftMenu>
      <footer visible="true">
      </footer>
      <toolBar visible="true">
      </toolBar>
      <instruction visible="true" >
        <![CDATA[ Default instruction is placed here. ]]>
      </instruction>
      <systemMessage visible="false">
        <value><![CDATA[ System message is placed here. ]]></value>
      </systemMessage>
      <generalInformation visible="false">
        <value><![CDATA[ General information is placed here. ]]></value>
      </generalInformation>
      <breadCrumb visible="false" externalSystemDimensionCode="" externalSystemCode=""></breadCrumb>

    </layout>
    <authorization>
      <location path="/Module1" allowAnonymous="true">
        <!-- '*' represents all roles. 
							If allow node does not exist, it means allow all roles except the ones specified in the deny node. 
							If deny node does not exist, it means deny all roles except the ones specified in the allow node.				
				<allow roleIds="*" />
				<deny roleIds="*" />							
				
        <deny roleIds="55,48" />
        <deny roleIds="3" />
        <allow roleIds="324,50" />
        <allow roleIds="*" />
        <allow roleIds="9" />
        <deny roleIds="55,48" />
        <deny roleIds="3" />
        <deny roleIds="55,48" />
        <deny roleIds="3" />
        <allow roleIds="*" />
        <allow roleIds="9" />
        <deny roleIds="3" />
        <allow roleIds="*" />
        <deny roleIds="3" />
        -->
       
      </location>
    </authorization>
  </pageGroup>
  <pageGroup id="contentPages">
    <layout>
      <pageTitle visible="true" imagePath="~/Platform/Include/Skins/EHB/Images/dashboard.png" >
        <value>
          <![CDATA[
                  <h2 class="main_title">
            <span>
                <img class="titleimg"  src="{0}">
                Task Summary Overview</span>
        </h2>
                ]]>
        </value>
      </pageTitle>
    </layout>
  </pageGroup>
  <pageGroup id="REI">
    <layout visible="false" windowTitle="Welcome to REI">
      <header visible="true" mode="Expand">
        <banner visible="true" />
        <userNavigation visible="true" />
        <globalSearch visible="true" />
        <globalNavigation visible="true" currentNavigationId="" />
      </header>
      <sideMenu visible="true" mode="Expand">
        <filter visible="true" />
        <localNavigation visible="true" currentNavigationId="" />
      </sideMenu>
      <footer visible="true">
      </footer>
      <instruction visible="true" mode="Expand">
        <![CDATA[ Default instruction is placed here. ]]>
      </instruction>
      <systemMessage visible="true">
        <value><![CDATA[ System message is placed here. ]]></value>
      </systemMessage>
      <generalInformation visible="false">
        <value><![CDATA[ General information is placed here. ]]></value>
      </generalInformation>

    </layout>
    <authorization>
      <location path="/Module1" allowAnonymous="true">
        <!-- '*' represents all roles. 
							If allow node does not exist, it means allow all roles except the ones specified in the deny node. 
							If deny node does not exist, it means deny all roles except the ones specified in the allow node.				
				<allow roleIds="*" />
				<deny roleIds="*" />							
				-->
        <deny roleIds="55,48" />
        <deny roleIds="3" />
        <allow roleIds="324,50" />
        <allow roleIds="*" />
        <allow roleIds="9" />
        <deny roleIds="55,48" />
        <deny roleIds="3" />
        <deny roleIds="55,48" />
        <deny roleIds="3" />
        <allow roleIds="*" />
        <allow roleIds="9" />
        <deny roleIds="3" />
        <allow roleIds="*" />
        <deny roleIds="3" />
        <allow roleIds="9" />
      </location>
    </authorization>
  </pageGroup>
</config>
