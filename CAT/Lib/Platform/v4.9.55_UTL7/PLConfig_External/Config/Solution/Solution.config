          </navigation>
          <navigation markupID="" navigationItemId="36BA90C7-4426-4EAA-B17E-00E419CBE408" displayValue="" destination="#" description=""  />
          <navigation navigationItemId="F83B02A4-32EB-45D1-A3BC-E488624587F4" markupID="tasksTab" displayValue="Tasks" destination="#" description="Work items for you" >
            <navigation navigationItemId="49CD78C0-9EC9-4D88-BF11-164C66B77436" markupID="browseTasksSubTab" displayValue="Browse" destination="#" description="Browse" parentID="F83B02A4-32EB-45D1-A3BC-E488624587F4"  />
