  <statement name="SetSavedSearchDefaultById" connection="Common">
    <param id="SavedSearchId" type="String" />
    <sql>
      update d
      set DefaultSearch = 0
      from
          (
            select *
            from PFM_SRCH_SavedSearch a
            <where>
              <exp op="=" dbField="a.SavedSearchId" paramId="SavedSearchId" />
            </where>
          ) b
          join
          (
            select *
            from PFM_SRCH_SavedSearch c
          ) d
            on b.GroupName = d.GroupName and b.CurrentUserId = d.CurrentUserId;
            
         update PFM_SRCH_SavedSearch
         set PFM_SRCH_SavedSearch.DefaultSearch = 1
         <where>
				   <exp op="=" dbField="SavedSearchId" paramId="SavedSearchId" />
			   </where>
    </sql>
  </statement>
