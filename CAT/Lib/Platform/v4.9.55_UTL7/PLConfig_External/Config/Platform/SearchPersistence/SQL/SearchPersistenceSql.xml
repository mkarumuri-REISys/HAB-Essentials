    </sql>
  </statement>

  <statement name="GetRuntimePageId" connection="Common">
    <param id="RelativeURL" type="String" required="true" />
    <param id="PageTypeCode" type="Int32" required="true" />
    <sql>
      declare @runtimeId uniqueidentifier
      select Top 1 @runtimeId = CORERuntimePageId
      from PFM_CORE_RuntimePage
      <where>
        <exp op="AND">
          <exp op="=" dbField="RelativeURL" paramId="RelativeURL" />
          <exp op="=" dbField="PageTypeCode" paramId="PageTypeCode" />
        </exp>
      </where>
      select @runtimeId as CORERuntimePageId
    </sql>
  </statement>

