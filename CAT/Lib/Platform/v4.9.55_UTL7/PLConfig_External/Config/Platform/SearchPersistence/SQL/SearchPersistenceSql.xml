<statements xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="file://Y:/workspace/tools/REISchemas/REIData.xsd">
	<statement name="GetSavedSearchByName" connection="Common">
		<param id="CurrentUserId" type="String" />
		<param id="GroupName" type="String" size="500" />
		<param id="SearchName" type="String" size="50" />
		<sql>
      select SavedSearchId, CurrentUserId, GroupName,
             SearchName, SearchParams, DisplayText, RuntimePageId, 
             DefaultSearch, CreatorId, CreatedDate, LastUpdateId, 
             LastUpdateDate
      from PFM_SRCH_SavedSearch
      <where>
				<exp op="AND">
					<exp op="=" dbField="CurrentUserId" paramId="CurrentUserId" />
					<exp op="=" dbField="GroupName" paramId="GroupName" />
					<exp op="=" dbField="SearchName" paramId="SearchName" />
          <exp op="IS" dbField="RuntimePageId">NULL</exp>
				</exp>
			</where>
		</sql>
	</statement>

