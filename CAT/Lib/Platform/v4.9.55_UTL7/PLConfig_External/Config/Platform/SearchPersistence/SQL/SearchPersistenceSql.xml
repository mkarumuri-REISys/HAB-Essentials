  <statement name="GetRecentSearches" connection="Common">
    <param id="UserId" type="Guid" required="true" />
    <sql>
      select top 5 * from PFM_SRCH_SavedSearch
      <where>
        <exp op="AND">
          <exp dbField="CurrentUserId" op="=" paramId="UserId" />
          <exp dbField="RuntimePageId" op="IS NOT">NULL</exp>
        </exp>
      </where>
      order by LastUpdateDate desc
    </sql>
  </statement>

  <statement name="GetRecentSearchById" connection="Common">
