  </statement>
  <statement name="GetCountries" connection="Common">
    Select LongDisplayValue, LookupCode, IsdCode from LookupCountry
    order by LongDisplayValue asc
  </statement>
  <statement name="GetStatesOrdered" connection="Common">
    <sql>
      SELECT
      LookupCode,
      ShortDisplayValue
      ,ShortDisplayValue as DisplayValue
      FROM
      LookupState
      ORDER BY
      CASE
      WHEN 'NA' = ShortDisplayValue THEN 1
      ELSE 0
      END,
      ShortDisplayValue
    </sql>
  </statement>

