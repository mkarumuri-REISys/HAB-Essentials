  <statement name="IsExistingEmail">
    <param id="emailAddressField" type="String" />
    <sql>
      select top 1 contactaddress as result
      from ContactAddresses WITH (NOLOCK)
      <where>
        <exp op="and">
          <exp op="=" dbField="ContactAddressTypeCode">1</exp>
          <exp op="=" dbField="ContactAddress" paramId="emailAddressField" />
        </exp>
      </where>
    </sql>
  </statement>

