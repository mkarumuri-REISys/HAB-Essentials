  <statement name="GetZ5Data" connection="Common">
    <param id="Zipcodes" type="String" />
    <sql>
      SELECT *
      FROM Z5
      <where>
        <exp op="IN" dbField="ZIP" paramId="Zipcodes" />
      </where>
      ORDER BY ZIP
    </sql>
  </statement>

  <statement name="GetZ5DataNew" connection="Common">
    <param id="Zipcodes" type="String" />
    <sql>

      Declare @Z5XmlDataInput as XML
      SET @Z5XmlDataInput = <exp paramId="Zipcodes"/> ;
      WITH InputTbl
      AS
      (
      SELECT
      Items.r.value('(Zip/node())[1]', 'varchar(5000)') AS Zip
      FROM @Z5XmlDataInput.nodes('Z5InputData/ZipCodes/Z5') AS Items (r)
      )

      SELECT DISTINCT A.ZIP, A.Preferred, A.County, A.St  FROM Z5 A
      JOIN InputTbl XmlTable ON A.ZIP = XmlTable.Zip
      ORDER BY A.ZIP, A.Preferred, A.County, A.St
    </sql>
  </statement>

  <statement name="GetAddressPurpose">
    Select LookupCode, ShortDisplayValue as DisplayValue from LookupAddressPurpose
    where IsNull(IsExcluded, 0) = 0
