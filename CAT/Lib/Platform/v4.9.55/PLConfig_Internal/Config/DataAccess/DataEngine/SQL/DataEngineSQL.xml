						<exp op="=" dbField="B.RoleId" paramId="Role_Id" />
					</exp>
				</where>
			</optional>
			</sql>
	</statement>
	<statement name="GetUserRolesOptional" connection="Gems">
		<sql>
			<param id="User_Name" type="String" size="20" required="true" />
			<param id="Role_Id" type="Int32" default="0" />
			<param id="tempDatetime" type="string" default="A.UserName desc" />
			<select> A.UserName,A.AgreementId,A.DefaultRoleId,B.RoleId
			<optional depends="Role_Id==0">
				,Cast(B.LastReviewedBy as varchar(50)) LastReviewedBy
