	<statement name="GetUserRoles" connection="Gems">
		<sql>
			<param id="User_Name" type="String" size="20" required="true" />
			<param id="Role_Id" type="Int32" default="0" />
			<param id="tempDatetime" type="string" default="A.UserName desc" />
			<select> A.UserName,A.AgreementId,A.DefaultRoleId,B.RoleId
			</select>
			FROM GEMS.dbo.AC_User A
			JOIN GEMS.dbo.AC_RelUserRole B ON A.UserId = B.UserId
			JOIN GEMS.dbo.AC_Role C ON B.RoleId = C.RoleId
			<optional depends="Role_Id==0">
				<where>
					<exp op="=" dbField="A.UserName" paramId="User_Name" />
				</where>
			</optional>
			<optional depends="Role_Id!=0">
				<where>
					<exp op="and">
						<exp op="=" dbField="A.UserName" paramId="User_Name" />
						<exp op="=" dbField="B.RoleId" paramId="Role_Id" />
					</exp>
				</where>
			</optional>
			<sort paramId="tempDatetime" ></sort>
		</sql>
	</statement>
