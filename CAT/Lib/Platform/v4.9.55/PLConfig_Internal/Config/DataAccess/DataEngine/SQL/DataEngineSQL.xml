	<statement name="GetTotalUsers">
		<sql>
			<param id="RoleId" type="Int32" />
			<param id="UserTypeCode" type="Int32" />
			
			SELECT COUNT(*) AS Result FROM GEMS.dbo.AC_User (NOLOCK)
			<where>
				<exp op="and">
					<exp op="=" dbField="DefaultRoleId" paramId="RoleId" />
					<exp op="=" dbField="UserTypeCode" paramId="UserTypeCode" />
				</exp>
			</where>

		</sql>
	</statement>
	<statement name="GetUserActions">
		<sql>
			<param id="UserIds" type="String" />

			SELECT COUNT(ByUserId) AS Result
			FROM PlatformUserAction
			<where>
				<exp op="IN" dbField="ByUserId" paramId="UserIds" />
			</where>
		</sql>
	</statement>
