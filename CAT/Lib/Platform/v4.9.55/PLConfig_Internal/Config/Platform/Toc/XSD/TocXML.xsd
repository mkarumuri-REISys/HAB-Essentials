<?xml version="1.0" encoding="utf-8"?>
<xs:schema attributeFormDefault="unqualified" elementFormDefault="qualified" xmlns:xs="http://www.w3.org/2001/XMLSchema">
	<xs:element name="toc" type="tocType" />
	<xs:complexType name="tocType" mixed="true">
		<xs:sequence minOccurs="1" maxOccurs="unbounded">
			<xs:sequence minOccurs="1" maxOccurs="1">
				<xs:element name="defaultControllerURL" type="xs:string" />
				<xs:element name="usesGrouping" type ="xs:string"/>
			</xs:sequence>
			<xs:sequence minOccurs="1" maxOccurs="unbounded">
				<xs:element name="section" type="sectionType" />
			</xs:sequence>
		</xs:sequence>
		<xs:attribute name ="version" type ="xs:int"/>
		<xs:attribute name ="description" type ="xs:string"/>
	</xs:complexType>

	<xs:complexType name="sectionType">
		<xs:sequence minOccurs="1" maxOccurs="unbounded">
			<xs:sequence minOccurs="0" maxOccurs="unbounded">
				<xs:element name="section" type="sectionType" />
			</xs:sequence>
			<xs:sequence minOccurs="1" maxOccurs="unbounded">
				<xs:element name="item" type="itemType" />
			</xs:sequence>
			<xs:sequence minOccurs ="0" maxOccurs ="1">
				<xs:element name ="defaultControllerURL" type ="xs:string"/>
			</xs:sequence>
		</xs:sequence>
		<xs:attribute name="controllerURL" type="xs:string" />
		<xs:attribute name="currentlyUsed" type="xs:string" />
		<xs:attribute name="customCss" type="xs:string" />
		<xs:attribute name="displayValue" type="xs:string" />
		<xs:attribute name="id" type="xs:string" />
		<xs:attribute name="resourceValue" type="xs:string" />
		<xs:attribute name="resourceTypeCode" type="xs:int" />        
	</xs:complexType>

	<xs:complexType name="itemType">
		<xs:sequence minOccurs="1" maxOccurs="unbounded">
				<xs:element name="action" type="actionType" />
		</xs:sequence>
		<xs:attribute name="attachmentId" type="xs:string" />
		<xs:attribute name="currentlyUsed" type="xs:string" />
		<xs:attribute name="displayValue" type="xs:string" />
		<xs:attribute name="id" type="xs:string" />
		<xs:attribute name="minAttachments" type="xs:int" />
		<xs:attribute name="maxAttachments" type="xs:int" />
		<xs:attribute name="orderAttachmentBy" type="xs:string" />
		<xs:attribute name="purposeCode" type="xs:int" />
		<xs:attribute name="purposeDescription" type="xs:string" />
		<xs:attribute name="requiredFlag" type="xs:string" />
		<xs:attribute name="resourceValue" type="xs:string" />
		<xs:attribute name="resourceTypeCode" type="xs:int" />
		<xs:attribute name="type" type="itemContentType" />
		<xs:attribute name="useCustomAttachmentPage" type="xs:string" />
        <xs:attribute name="toolTip" type="xs:string" />
	</xs:complexType>

	<xs:complexType name="actionType">
		<xs:attribute name="id" type="xs:string" />
		<xs:attribute name="displayValue" type="xs:string" />
		<xs:attribute name="additionalParameters" type="xs:string" />
		<xs:attribute name="pageURL" type="xs:string" />
	</xs:complexType>

	<xs:simpleType name="itemContentType">
		<xs:restriction base="xs:token">
			<xs:enumeration value="HTML"/>
			<xs:enumeration value="DOCUMENT"/>
			<xs:enumeration value="REPORT"/>
		</xs:restriction>
	</xs:simpleType>
</xs:schema>
