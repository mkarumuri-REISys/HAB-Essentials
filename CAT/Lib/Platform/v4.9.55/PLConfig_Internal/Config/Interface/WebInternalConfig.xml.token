<webConfig>
  <errorLog>C:\Projects\CATProject\PlatformLiteLogs</errorLog>
  <sessionTimeOut>30</sessionTimeOut>
  <sessionTimeOutWarning>1</sessionTimeOutWarning>
  <userType>2</userType>
  <!-- 1: External; 2: Internal-->
  <!-- IMPORTANT -->
  <websiteURL>#{EHB_ExternalWebsiteURL}</websiteURL>
  <internalWebsiteURL>#{EHB_internalWebsiteURL}</internalWebsiteURL>
  <externalWebsiteURL>#{EHB_ExternalWebsiteURL}</externalWebsiteURL>

  <feedbackLink>#{EHB_ExternalfeedbackLink}</feedbackLink>
  <callCenter>
    <phone>877-Go4-HRSA/877-464-4772;301-998-7373</phone>
    <email>CallCenter@HRSA.GOV</email>
    <hours>8:00 a.m. to 8:00 p.m. Eastern Time (E.T.), Monday through Friday</hours>
  </callCenter>
  <impersonation>
    <userId>#{Env.FSImpersonationUserID}</userId>
    <password>#{Env.FSImpersonationPwd}</password>
    <domain>#{Env.OITNETDomain}</domain>
  </impersonation>
  <CookieName>internal_cookie</CookieName>
  <accountLockoutEffectiveMins>30</accountLockoutEffectiveMins>
  <programSpecificSystemId>16</programSpecificSystemId>
  <repository>
    <layout>DB</layout>
  </repository>  
  <client>
    <baseEndpointAddress>#{EHB_ExternalbaseEndpointAddress}</baseEndpointAddress>
    <!-- <baseEndpointAddress>#{EHB_ExternalbaseEndpointAddress}</baseEndpointAddress> -->
    <!-- <baseEndpointAddress>https://hrsa.reisys.com/EHBEPS_PFMLite/Platform/WebServices/</baseEndpointAddress> -->
        
    <!--<baseEndpointAddress>#{EHB_ExternalbaseEndpointAddress}</baseEndpointAddress>-->
  </client>
  <environment>#{EHB_Environment}</environment>
  <helpSystemId>9</helpSystemId>
</webConfig>
