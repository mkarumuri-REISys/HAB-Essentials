<configuration>
  <system.serviceModel>
    <bindings>
      <basicHttpBinding>
        <binding name="BasicHttpBindingConfig">
          <readerQuotas maxStringContentLength="65536" />
          <security mode="None" />
        </binding>
        <binding name="BasicHttpsBindingConfig">
          <readerQuotas maxStringContentLength="65536" />
          <security mode="Transport" />
        </binding>
      </basicHttpBinding>      
    </bindings>
    <behaviors>
      <endpointBehaviors>
        <behavior name="EndpointBehavior">
          <dataContractSerializer maxItemsInObjectGraph="2147483647" />
        </behavior>
      </endpointBehaviors>
      <serviceBehaviors>
        <behavior name="ServiceBehavior">
          <serviceMetadata httpGetEnabled="false"  httpsGetEnabled="true"/>
          <serviceDebug includeExceptionDetailInFaults="true" />
          <serviceAuthorization impersonateCallerForAllOperations="false" />
          <serviceThrottling maxConcurrentCalls="32" maxConcurrentSessions="200"
           maxConcurrentInstances="232" />
          <dataContractSerializer maxItemsInObjectGraph="2147483647" />
          <serviceCredentials>
            <userNameAuthentication userNamePasswordValidationMode="Custom"
             customUserNamePasswordValidatorType="REISys.Platform.Services.WebServiceAuthentication.PlatformWebServiceAuthenticator,REISys.Platform.Services" />
          </serviceCredentials>
        </behavior>
      </serviceBehaviors>

    </behaviors>
    <extensions>
      <behaviorExtensions>
        <add name="coreFaultBehavior" type="REISys.Platform.Services.FaultManagement.CoreFaultBehavior, REISys.Platform.Services, Version=2.0.5.0, Culture=neutral, PublicKeyToken=null"/>
        <add name="ClientCredentialIdentifer" type="REISys.Platform.Services.WebServiceAuthentication.ServiceIdentifierBehaviourExtension, REISys.Platform.Services, Version=2.0.5.0, Culture=neutral, PublicKeyToken=null" />
      </behaviorExtensions>
    </extensions>
    <services>
      <service behaviorConfiguration="ServiceBehavior" name="REISys.Platform.Services.ServiceBus.TestServiceBusExternalServiceWS">
        <endpoint behaviorConfiguration="EndpointBehavior" binding="basicHttpBinding"
          bindingConfiguration="BasicHttpsBindingConfig" name="BasicHttpsEndpoint"
          contract="REISys.Platform.Services.ServiceBus.IServiceBusExternalService" />
      </service>
    </services>
  </system.serviceModel>
</configuration>