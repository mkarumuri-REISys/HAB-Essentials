	<statement name="TemplateCountResourceFilters">
		<param id ="ResourceTypeCode" type ="Int32" required ="true"/>
		<param id ="ResourceValue" type ="String" required ="true" size ="36"/>
		<sql>
			SELECT TemplateId, COUNT(TemplateId) AS TemplatesCount
			FROM TemplateResourceFilter
			WHERE TemplateId IN
					(
					SELECT TEmplateId FROM TemplateResourceFilter
					<where>
					
					<exp op ="AND">
						<exp op ="=" dbField ="ResourceTypeCode" paramId ="ResourceTypeCode"/>
						<exp op ="=" dbField ="ResourceValue" paramId ="ResourceValue"/>
					</exp>
					</where>
					)
			
			GROUP BY TemplateId
		</sql>
	</statement>
