	<statement name="CheckFiltersRequiredFlagForLookupCode">
		<param id ="hidLookupCode" />
		<param id ="hidTemplateFiltersRequiredFlag"/>
		<sql>
			IF NOT EXISTS
			( SELECT * FROM LookupTemplateType
			<where>
				<exp op ="AND">
					<exp op ="=" dbField ="LookupCode" paramId ="hidLookupCode"/>
					<exp op ="=" dbField ="TemplateFiltersRequiredFlag" paramId ="hidTemplateFiltersRequiredFlag"/>
				</exp>
			</where>
				)
			BEGIN
				IF EXISTS
				(SELECT * FROM LookupTemplateType
				<where>
					<exp op ="AND">
						<exp op ="=" dbField ="LookupCode" paramId ="hidLookupCode"/>
						<exp op ="=" dbField ="TemplateFiltersRequiredFlag">1</exp>
					</exp>
				</where>
			)
			BEGIN
			SELECT '1' AS result
			END
			ELSE
			BEGIN
			SELECT '0' AS result
			END
			END
			ELSE
			BEGIN
			SELECT '1' AS result
			END
		</sql>
	</statement>
