  <statement name="GetTemplates">
    <param id="TemplateId" type="Guid" size="36" />
    <param id="TemplateTypeCode" type="Int32" />
    <param id="ResourceFilters" type="string" size="1000" />
    <param id="IncludeEmptyTemplates" type="Boolean" />
    <param id="UserId" type="Guid" size="36" />
    <sql>


      SELECT
      t.TemplateId  as 'Id'
      ,t.TemplateName  as 'Name'
      ,ISNULL(t.TemplateDescription, '') as 'Description'  --Can be Null
      ,ISNULL(t.StatementName, '') as 'StatementName'              --Can be Null
      ,ISNULL(t.ComponentName, '') as 'ComponentName'              --Can be Null
      ,t.ActiveDate  as 'ActiveDate'                               --Can be Null
      ,t.InactiveDate  as 'ExpiryDate'                          --Can be Null
      ,t.TemplateTypeCode as 'TypeCode'
      ,t.AssociatedAttachmentPurposeCode as PurposeCode
      ,lta.Description as AttachmentPurposeCodeDescription
      ,isnull(t.MinAttachmentCount, 0) as 'MinAttachmentCount'
      ,isnull(t.MaxAttachmentCount, 0) as 'MaxAttachmentCount'
      ,ISNULL(t.DisplayOrder,'') as 'DisplayOrder'
      ,ltt.TemplateFiltersRequiredFlag  as 'IsFiltersRequired'
      ,t.[CreatorId]   as 'CreatorId'
      ,t.[CreatedDate]  as 'CreatedDate'
      ,t.[LastUpdateId]  as 'LastUpdateId'
      ,t.[LastUpdateDate]  as 'LastUpdateDate'
      FROM Templates t
      INNER JOIN LookupTemplateType ltt on ltt.LookupCode = t.TemplateTypeCode
      INNER JOIN LookupAttachmentPurpose lta on lta.LookupCode = t.AssociatedAttachmentPurposeCode
      <optional depends="ResourceFilters">
        join TemplateResourceFilter trf on trf.TemplateId = t.TemplateId
      </optional>
      <where>
        <exp op="and">
          <exp op="=" dbField="t.TemplateId" paramId="TemplateId"/>
          <exp op="=" dbField="t.TemplateTypeCode" paramId="TemplateTypeCode"/>
          <exp op="&gt;" dbField="isnull(t.InactiveDate, getDate()+1)">getdate()</exp>
          <exp op="in" dbField="trf.ResourceTypeValue" paramId="ResourceFilters" />
          <exp op="=" dbField="t.CreatorId" paramId="UserId"/>
        </exp>
      </where>
      order by DisplayOrder

      SELECT
      ta.AttachmentId  as 'Id'
      ,ta.AttachmentInstance  as 'AttachmentInstance'
      ,ta.TemplateId  as 'TemplateId'
      ,ta.AttachmentPurposeCode as 'AttachmentPurposeCode'
      ,ta.CreatorId  as 'CreatorId'
      ,ta.CreatedDate as 'CreatedDate'
      ,ta.LastUpdateId as 'LastUpdateId'
      ,ta.LastUpdateDate  as 'LastUpdateDate'
      FROM TemplateAttachment ta
      INNER JOIN Templates t ON ta.TemplateId = t.TemplateId
      <where>
        <exp op="and">
          <exp op="=" dbField="t.TemplateId" paramId="TemplateId"/>
          <exp op="=" dbField="t.TemplateTypeCode" paramId="TemplateTypeCode"/>
          <exp op="&gt;" dbField="isnull(t.InactiveDate, getDate()+1)">getdate()</exp>
          <exp op="=" dbField="ta.CreatorId" paramId="UserId"/>
        </exp>
      </where>
      order by DisplayOrder

    </sql>
  </statement>
  
  
	<statement name="SelectTemplates">
		<param id="TemplateTypeCode" type="Int32" />
		<sql>
			select distinct
			cast(T.TemplateId as varchar(36)) as TemplateId,
			T.TemplateName,
			ISNULL(T.TemplateDescription, ' ') as TemplateDescription,
			ISNULL(T.StatementName, ' ') as StatementName,
			ISNULL(T.ComponentName, ' ') as ComponentName,
			T.AssociatedAttachmentPurposeCode,
			isnull(T.MinAttachmentCount, 0) as MinAttachmentCount,
			isnull(T.MaxAttachmentCount, 0) as MaxAttachmentCount,
			ISNULL(T.DisplayOrder, ' ') as DisplayOrder,
			LTT.TemplateFiltersRequiredFlag
			from Templates T
			join LookupTemplateType LTT on LTT.LookupCode = T.TemplateTypeCode
			<where>
				<exp op ="AND">
					<exp op="=" dbField="T.TemplateTypeCode" paramId="TemplateTypeCode"/>
					<exp op="&gt;" dbField="isnull(T.InactiveDate, getDate()+1)">getdate()</exp>
				</exp>
			</where>
			order by DisplayOrder
		</sql>
	</statement>
