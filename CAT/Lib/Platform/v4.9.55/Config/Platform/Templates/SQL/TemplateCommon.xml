<statements xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="file://Y:/workspace/tools/REISchemas/REIData.xsd">
	<statement name="GetTemplateInfo">
		<param id="TemplateId" type="string" size="36" />
		<param id="TemplateTypeCode" type="Int32" />
		<param id="ResourceFilters" type="string" size="1000" />
		<param id="IncludeEmptyTemplates" type="Boolean" />
		<sql>
			select distinct
			cast(T.TemplateId as varchar(36)) as TemplateId,
			T.TemplateName,
			TA.AttachmentId as TemplateAttachmentId,
			TA.AttachmentInstance as TemplateAttachmentInstance,
			ISNULL(T.TemplateDescription, '') as TemplateDescription,
			ISNULL(T.StatementName, '') as StatementName,
			ISNULL(T.ComponentName, '') as ComponentName,
			ISNULL(cast(T.ActiveDate as varchar(20)), '') as ActiveDate,
			ISNULL(cast(T.InactiveDate as varchar(20)),'') as InactiveDate,
			T.TemplateTypeCode,
			T.AssociatedAttachmentPurposeCode,
			LTA.Description as AttachmentPurposeCodeDescription,
			isnull(T.MinAttachmentCount, 0) as MinAttachmentCount,
			isnull(T.MaxAttachmentCount, 0) as MaxAttachmentCount,
			ISNULL(T.DisplayOrder,' ') as DisplayOrder,
			LTT.TemplateFiltersRequiredFlag
			from Templates T
			<optional depends="IncludeEmptyTemplates">
				LEFT OUTER JOIN
			</optional>
			<optional depends="!IncludeEmptyTemplates">
				join
			</optional>
			TemplateAttachment TA on T.TemplateId = TA.TemplateId
			join LookupTemplateType LTT on LTT.LookupCode = T.TemplateTypeCode
			join LookupAttachmentPurpose LTA on LTA.LookupCode = T.AssociatedAttachmentPurposeCode
			<optional depends="ResourceFilters">
				join TemplateResourceFilter TRF on TRF.TemplateId = T.TemplateId
			</optional>
			<where>
				<exp op="and">
					<exp op="=" dbField="T.TemplateId" paramId="TemplateId"/>
					<exp op="=" dbField="T.TemplateTypeCode" paramId="TemplateTypeCode"/>
					<exp op="&gt;" dbField="isnull(T.InactiveDate, getDate()+1)">getdate()</exp>
					<exp op="in" dbField="TRF.ResourceTypeValue" paramId="ResourceFilters" />
				</exp>
			</where>
			order by DisplayOrder
		</sql>
	</statement>

