<statements>
    <statement name="GetCache" connection="Common">
        <param id="CacheKey" required="false" default="" type="String" size="500" />
        <sql>
            Select Value from [dbo].PFM_CORE_Cache
            <where>
                <exp op="AND">
                    <exp dbField="CacheKey" paramId="CacheKey" op="=" />
                </exp>
            </where>
        </sql>
    </statement>
 
    <statement name="SaveCache" connection="Common" >
        <param id="CacheKey" required="false" default="" type="String" size="500" />
        <param id="Value" required="false" default="" type="binary" />
        <sql>
            if exists(Select * from PFM_CORE_Cache where CacheKey=<exp paramId="CacheKey" />)
            BEGIN
            UPDATE [dbo].PFM_CORE_Cache
            <columns mode="UPDATE">
                <column dbField="Value" paramId="Value" />
                <column dbField="LastUpdateDate">GETDATE()</column>
                <column dbField="LastUpdateId">'15D6996D-1FA4-4345-980E-68BBA850E25F'</column>
            </columns>
            <where>
                <exp op="AND">
                    <exp dbField="CacheKey" paramId="CacheKey" op="=" />
                </exp>
            </where>
            END
            ELSE
            BEGIN
            Insert into [dbo].PFM_CORE_Cache
            <columns mode="insert">
                <column dbField="CacheId">NEWID()</column>
                <column dbField="CacheKey" paramId="CacheKey" />
                <column dbField="Value" paramId="Value" />
                <column dbField="CreatorId">'15D6996D-1FA4-4345-980E-68BBA850E25F'</column>
                <column dbField="CreatedDate">GETDATE()</column>
                <column dbField="LastUpdateId">'15D6996D-1FA4-4345-980E-68BBA850E25F'</column>
                <column dbField="LastUpdateDate">GETDATE()</column>

            </columns>
            END
        </sql>
    </statement>

    <statement name="DeleteCacheItem" connection="Common">
        <param id="CacheKey" required="false" default="" type="String" size="500" />
        <sql>
            Delete from [dbo].PFM_CORE_Cache
            <where>
                <exp op="AND">
                    <exp dbField="CacheKey" paramId="CacheKey" op="=" />
                </exp>
            </where>
        </sql>
    </statement>
</statements>