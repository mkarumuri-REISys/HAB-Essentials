<configuration>
 <configSections>
    <section name="enterpriseLibrary.ConfigurationSource" type="Platform.CrossCutting.Configuration.StorageProvider.FileStorageProvider.SourceSettings,Platform.CrossCutting.Configuration,Version=3.0.0.0,Culture=neutral,PublicKeyToken=677fce62a3a80367" />
 </configSections>

  <enterpriseLibrary.ConfigurationSource enableCaching="false">
    <sources>
      <add name="defaultSource" sourceType="file" basePath="" filePath="default.config" />
      <add name="solution" sourceType="file" basePath="Y:\Technical\Scripts\1.9\Service\Config" filePath="SolutionSettings.config" />
    </sources>
  </enterpriseLibrary.ConfigurationSource>
  <appSettings>
    <add key="webpages:Version" value="3.0.0.0"/>
    <add key="webpages:Enabled" value="false"/>
    <add key="ClientValidationEnabled" value="true"/>
    <add key="UnobtrusiveJavaScriptEnabled" value="true"/>
