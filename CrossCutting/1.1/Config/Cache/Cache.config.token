<config>
  <appSettings>
	<enableRedis>__REDISENABLE__</enableRedis>
    <serverName>__REDISSERVERNAME__</serverName>
    <portNumber>__REDISPORTNUMBER__</portNumber>
    <allowAdmin>true</allowAdmin>
    <DBPassword>__REDISDBPASSWORD__</DBPassword>
	<enableSSL>__REDISENABLESSL__</enableSSL>
	<SSLHostName>__REDISSSLHOSTNAME__</SSLHostName>
	<certificatePFXfilepath>__REDISCERTIFICATEPFXFILEPATH__</certificatePFXfilepath>
	<certificatePFXpassword>__REDISCERTIFICATEPFXPASSWORD__</certificatePFXpassword>
  </appSettings>
</config>