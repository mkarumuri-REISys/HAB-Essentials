		<add key="friday_window_start" value="window_start_4" />
		<add key="saturday_window_start" value="window_start_4" />
		<add key="sunday_window_start" value="window_start_4" />
		<add key="monday_window_end" value="window_end_4" />
		<add key="tuesday_window_end" value="window_end_4" />
		<add key="wednesday_window_end" value="window_end_4" />
		<add key="thursday_window_end" value="window_end_4" />
		<add key="friday_window_end" value="window_end_4" />
		<add key="saturday_window_end" value="window_end_4" />
		<add key="sunday_window_end" value="window_end_4" />
		<!-- logging -->
		<add key="habDataSystemId" value="6" />
		<add key="maxDegreeOfParallelism" value="1" />
		<!-- email -->
		<add key="EmailTemplatePath" value="xml\Email.xml" />
		<add key="SMTPServer" value="smtpgw.reisys.com" />
		<!--todo: verify AdrSupportEmail-->
		<!--<add key="AdrSupportEmail" value="AdrSupport@leidos.com"/>-->
		<add key="AdrSupportEmail" value="brstest@smtpgw.reisys.com" />
		<add key="hccEmail" value="brstest@smtpgw.reisys.com" />
		<add key="devEmail" value="brstest@smtpgw.reisys.com" />
		<add key="devCC" value="" />
		<add key="devBCC" value="" />
    <add key="SecurityKeyProvider" value="REISys.Security.DevKeyProvider,REISys.Security.KeyProvider" />
		<add key="FileUploadPath" value="Y:\FileUpload\ADR\" />
		<add key="environment" value="test" />
	</appSettings>
