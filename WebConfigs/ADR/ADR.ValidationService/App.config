    <add key="window_end_4" value="23:59:59" />
    <add key="monday_window_start" value="window_start_4" />
    <add key="tuesday_window_start" value="window_start_4" />
    <add key="wednesday_window_start" value="window_start_4" />
    <add key="thursday_window_start" value="window_start_4" />
    <add key="friday_window_start" value="window_start_4" />
    <add key="saturday_window_start" value="window_start_4" />
    <add key="sunday_window_start" value="window_start_4" />
    <add key="monday_window_end" value="window_end_4" />
    <add key="tuesday_window_end" value="window_end_4" />
    <add key="wednesday_window_end" value="window_end_4" />
    <add key="thursday_window_end" value="window_end_4" />
    <add key="friday_window_end" value="window_end_4" />
    <add key="saturday_window_end" value="window_end_4" />
    <add key="sunday_window_end" value="window_end_4" />
    <!-- logging -->
    <add key="habDataSystemId" value="6" />
    <add key="maxDegreeOfParallelism" value="1" />
    <add key="ClientSettingsProvider.ServiceUri" value="" />
    <add key="SecurityKeyProvider" value="REISys.Security.ProdKeyProvider,REISys.Security.KeyProvider" />
    <add key="environment" value="OM INT" />
