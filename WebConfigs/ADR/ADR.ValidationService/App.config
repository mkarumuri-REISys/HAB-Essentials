  <appSettings>
    <add key="connectionStringKey" value="Adrdataconn" />
    <add key="PlatformConfigBasePath" value="Y:\WorkSpace\HAB-Platformv4.21.5\Platform\v4.21.5\Config\Platform" />
    <!-- scheduling -->
    <add key="autoReload_Freq" value="60" />
    <add key="timerInterval" value="6000" />
    <!-- frequency of running task -->
    <add key="freq_min_1" value="30" />
    <add key="freq_min_2" value="300" />
    <add key="freq_min_3" value="5" />
    <add key="freq_min_4" value="1" />
    <add key="monday_freq" value="freq_min_4" />
    <add key="tuesday_freq" value="freq_min_4" />
    <add key="wednesday_freq" value="freq_min_4" />
    <add key="thursday_freq" value="freq_min_4" />
    <add key="friday_freq" value="freq_min_4" />
    <add key="saturday_freq" value="freq_min_4" />
    <add key="sunday_freq" value="freq_min_4" />
    <!-- window for running task -->
    <add key="window_start_1" value="22:00:00" />
    <add key="window_end_1" value="23:59:59" />
    <add key="window_start_2" value="00:00:00" />
    <add key="window_end_2" value="23:59:59" />
    <add key="window_start_3" value="00:00:00" />
    <add key="window_end_3" value="23:59:59" />
